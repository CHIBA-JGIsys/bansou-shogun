# =============================================================================
# CRM Application - 環境変数設定
# =============================================================================
#
# 【セットアップ手順】
# 1. このファイルをコピーして .env.local を作成
#    cp .env.example .env.local
#
# 2. 下記の説明を参考に、各変数に実際の値を設定
#
# 3. 設定が完了したら開発サーバーを起動
#    npm run dev
#
# =============================================================================

# =============================================================================
# Supabase（必須）
# =============================================================================
# 取得方法: Supabase Dashboard > Settings > API
#
# Project URL - プロジェクトのURL
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# anon (public) key - 公開用APIキー
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# =============================================================================
# Database - Supabase PostgreSQL（必須）
# =============================================================================
# 取得方法: Supabase Dashboard > Settings > Database > Connection string
#
# Transaction pooler (port 6543)
# - アプリケーションからの接続用
# - 高い同時接続数に対応
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432)
# - Prismaマイグレーション用
# - 直接データベースに接続
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# =============================================================================
# NextAuth.js（必須）
# =============================================================================
# アプリケーションのURL
# - 開発環境: http://localhost:3000
# - 本番環境: 実際のドメイン
NEXTAUTH_URL="http://localhost:3000"

# 秘密鍵（32文字以上のランダムな文字列）
# 生成コマンド: openssl rand -base64 32
# ※ setup.sh を使用すると自動生成されます
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl"

# =============================================================================
# Google OAuth（オプション）
# =============================================================================
# Googleアカウントでのログインを有効にする場合に設定
# 取得方法: https://console.cloud.google.com/apis/credentials
#
# OAuth 2.0 クライアントID
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# OAuth 2.0 クライアントシークレット
GOOGLE_CLIENT_SECRET="your-google-client-secret"

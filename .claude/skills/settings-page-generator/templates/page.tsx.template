"use client";

import { useState } from "react";
import { {{ICON}}, Plus, Search, MoreHorizontal } from "lucide-react";

// =============================================================================
// モックデータ（API接続前の仮データ）
// =============================================================================

// TABLE_CONTENT の場合
const mockItems = [
  {
    id: "1",
    name: "サンプル項目1",
    description: "説明文がここに入ります",
    createdAt: "2024-01-15",
  },
  {
    id: "2",
    name: "サンプル項目2",
    description: "説明文がここに入ります",
    createdAt: "2024-02-20",
  },
